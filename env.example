# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# PumpPortal data + local transaction builder
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local

# Local Solana wallet signing
# Use private key only, not seed phrase. Keep it in Railway Variables only.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=

# Modes: watch / paper / live
TRADING_MODE=watch
TRADING_CONFIRM=

# Tiny trade settings
TRADE_AMOUNT_SOL=0.005
SLIPPAGE_PERCENT=20
PRIORITY_FEE_SOL=0.00005
TRADE_POOL=auto

TAKE_PROFIT_PERCENT=25
STOP_LOSS_PERCENT=15
TRAILING_STOP_PERCENT=12
MAX_HOLD_SECONDS=600

MAX_TRADES_PER_HOUR=2
MAX_DAILY_TRADES=5
MAX_OPEN_TRADES=2
ONE_TRADE_PER_MINT=true

MIN_AI_SCORE_TO_TRADE=7
MIN_AI_SCORE_TO_ALERT=6

# Sources
ENABLE_PUMPPORTAL_NEW_TOKENS=true
ENABLE_X_RSS=true
X_RSS_CHECK_INTERVAL_SECONDS=60
TRADE_MANAGE_INTERVAL_SECONDS=15
PUMP_RECONNECT_SECONDS=10
X_RSS_FEEDS=

# DexScreener
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# Safety
MAX_ALERTS_PER_HOUR=15
AI_TEMPERATURE=0.15
BAD_NAME_KEYWORDS=test,scam,rug,honeypot,do not buy,fake
HEALTH_ALERT_COOLDOWN_SECONDS=1800
